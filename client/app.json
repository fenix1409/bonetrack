{
  "expo": {
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#009d6b",
      "dark": {
        "backgroundColor": "#006142"
      }
    },
    "name": "BoneTrack",
    "slug": "bonetrack",
    "version": "1.0.1",  
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": [
      "bonetrack"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fenix1409.bonetrack",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#009d6b",
          "dark": {
            "backgroundColor": "#006142"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0e0bd2b-a631-4114-937c-297d7cc63e76"
      }
    },
    "owner": "muhammadamin2119"
  }
}